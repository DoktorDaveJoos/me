#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
channel=${1:-dev}
if [ "$#" -gt 0 ]; then shift; fi
case "$channel" in
    debug) channel=dev ;;
    dev|preview|release) ;;
    *) printf '%s\n' 'Usage: ./scripts/bundle-macos [dev|preview|release]' >&2; exit 2 ;;
esac
exec python3 "$project_dir/scripts/macos-build.py" "$channel" "$@"
